SYS_TIME =$(shell date +%Y/%m/%d-%H:%M:%S;)
SYS_TIME += "for\ DRC"
COMMONFLAGS += -DWITH_LOG
COMMONFLAGS += -D_LINUX_

CXXFLAGS += $(COMMONFLAGS)
CXXFLAGS += -DLINUX_BUILD
CXXFLAGS += -DDRF_PROCESS

CFLAGS   += $(COMMONFLAGS)
