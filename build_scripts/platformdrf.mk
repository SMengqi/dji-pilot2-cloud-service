CFLAGS   += -DDRF_PROCESS

LINUX_PL          = y
BUILDNAME         = drf
BUILDCOMMON       = drf

PLATFORMLIB       = no

BLDVERSION        = v1
BUILD_DIR         = $(PSROOT)/build_$(BUILDCOMMON)/obj

